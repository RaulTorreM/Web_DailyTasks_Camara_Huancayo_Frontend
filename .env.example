# URL base de la API de DailyTasks.
# Desarrollo:  /api/dailytasks (Vite hace proxy a http://localhost:5095; ver vite.config.ts)
# Producción:  https://api.tu-dominio.com/api/dailytasks
VITE_API_URL=/api/dailytasks

# URL del hub SignalR.
# Desarrollo:  /hubs/dailytasks (Vite hace proxy con ws: true)
# Producción:  https://api.tu-dominio.com/hubs/dailytasks
VITE_HUB_URL=/hubs/dailytasks
